# Connect API
CONNECT_API_BASE_URL=https://capi.trintel.co.za/api/v4
CONNECT_API_KEY=your_service_account_token
CONNECT_COMPANY_ID=123
CONNECT_FOLDER_ID=456

# ZTE credentials
ZTE_USERNAME=your_zte_username
ZTE_PASSWORD=your_zte_password
ZTE_ENDPOINT_TOKEN=your_endpoint_here

# MQTT broker
MQTT_PROTOCOL=mqtts
MQTT_HOST=broker.example.com
MQTT_PORT=8883
MQTT_PID=0

# Device identity (optional overrides)
DEVICE_UID=
DEVICE_NAME_PREFIX=pi-signage
DEVICE_DESCRIPTION_PREFIX=Raspberry Pi signage agent

# Agent runtime
AGENT_STATE_FILE=/opt/signage/agent/state.json
MQTT_RECONNECT_DELAY_MS=5000
DOWNLOAD_TIMEOUT_MS=120000

# Signage behavior
MEDIA_DIR=/opt/signage/media
VLC_BIN=/usr/bin/cvlc
# Extra args appended after defaults:
# -I dummy --fullscreen --no-video-title-show --loop --vout=drm_vout
VLC_EXTRA_ARGS=
