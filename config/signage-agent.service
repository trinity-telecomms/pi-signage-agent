[Unit]
Description=Raspberry Pi Signage MQTT Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/signage/agent
EnvironmentFile=/opt/signage/agent/.env
ExecStart=/opt/signage/agent/signage-agent
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
